# Strong model: any litellm model id works. These runs used GPT-6 Luna on an Azure OpenAI deployment.
# Each run is capped at 20 model calls (step_limit in config/lakeqa.yaml).
OPENAI_API_KEY=<your-api-key>
STRONG_MODEL=openai/gpt-6-luna
STRONG_MODEL_KWARGS={"api_base": "https://<your-resource>.services.ai.azure.com/openai/v1"}
# Alternatives: STRONG_MODEL=gemini/gemini-2.5-flash (with GEMINI_API_KEY), or a local model like ollama_chat/qwen3.5:9b.

# Small model, local through Ollama.
SMALL_MODEL=ollama_chat/qwen2.5:3b

# Mid-size local model:  ./demo.sh qwen   or   run_agent.py --model qwen
QWEN_MODEL=ollama_chat/qwen3.5:9b
# qwen3.5 "thinks" by default; turning that off makes it ~2x faster with the same answers on these tasks.
QWEN_MODEL_KWARGS={"reasoning_effort": "none"}
